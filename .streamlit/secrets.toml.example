# Paste this (filled in) into Streamlit Community Cloud → App settings → Secrets. Never commit the real file.
[snowflake]
account = "<orgname>-<account_name>"
user = "<login name>"
authenticator = "SNOWFLAKE_JWT"
private_key = """-----BEGIN PRIVATE KEY-----
...contents of ~/.snowflake/rsa_key.p8...
-----END PRIVATE KEY-----"""
role = "<role>"
warehouse = "ANALYTICS_WH"
database = "BROKERAGE"
schema = "ANALYTICS"
